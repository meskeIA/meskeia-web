{
  "name": "meskeia-web-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npx kill-port 3050 || exit 0",
    "dev": "next dev -p 3050",
    "build": "node scripts/check-verticales.mjs && node scripts/check-sitemap.mjs && node scripts/check-enlaces-internos.mjs && node scripts/check-fiscal-manifiesto.mjs && node scripts/generate-app-dates.mjs && node scripts/generate-llm-index.js && node scripts/generate-delegum-es.mjs && node scripts/build-mcp-ui.mjs && next build --turbopack",
    "start": "next start -p 3050",
    "lint": "eslint",
    "test": "npx playwright test",
    "test:unit": "npx playwright test tests/formatters.spec.ts",
    "test:calc": "npx playwright test --config playwright.calc.config.ts",
    "test:a11y": "npx playwright test tests/accessibility.spec.ts",
    "ensayo:restauracion": "node scripts/ensayo-restauracion.mjs",
    "check:verticales": "node scripts/check-verticales.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:enlaces": "node scripts/check-enlaces-internos.mjs",
    "check:fiscal": "node scripts/check-fiscal-manifiesto.mjs",
    "audit:fiscal-fuentes": "node scripts/audit-fiscal-fuentes.mjs",
    "audit:motores": "node scripts/audit-motores-fiscales.mjs",
    "check:memoria": "node scripts/check-memoria.mjs",
    "generate:app-dates": "node scripts/generate-app-dates.mjs",
    "check:secrets": "git -c core.quotepath=false diff --cached --unified=0 --no-color --no-renames --diff-filter=ACM | node scripts/check-secrets.mjs",
    "audit:secrets": "git -c core.quotepath=false diff --unified=0 --no-color --no-renames 4b825dc642cb6eb9a060e54bf8d69288fbee4904 | node scripts/check-secrets.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "generate:llm-index": "node scripts/generate-llm-index.js",
    "generate:delegum-es": "node scripts/generate-delegum-es.mjs",
    "generate:mcp-ui": "node scripts/build-mcp-ui.mjs",
    "analyze": "set ANALYZE=true && npm run build",
    "check:vigencia": "node scripts/check-vigencia.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@libsql/client": "^0.17.3",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.17.0",
    "@trpc/next": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@vercel/mcp-adapter": "^0.3.2",
    "algebrite": "^1.4.0",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "flag-icons": "^7.5.0",
    "hls.js": "^1.6.16",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "js-yaml": "^4.2.0",
    "jspdf": "^4.2.1",
    "jstat": "^1.9.6",
    "jszip": "^3.10.1",
    "mathjs": "^15.2.0",
    "minisearch": "^7.2.0",
    "mp4-muxer": "^5.2.1",
    "mp4box": "^0.5.2",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "resend": "^6.18.0",
    "sql.js": "^1.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "@axe-core/playwright": "^4.11.3",
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.62.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.11.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "google-auth-library": "^10.9.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
