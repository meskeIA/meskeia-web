{
  "openapi": "3.1.0",
  "info": {
    "title": "meskeIA — Cocina Técnica",
    "description": "Calculadoras de precisión para panadería y repostería: baker's percentage, hidratación, masa madre, DDT, puntos del azúcar, gelatinas, ganache y escalado de recetas.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "https://meskeia.com" }
  ],
  "paths": {
    "/api/chatgpt/porcentaje-panadero": {
      "post": {
        "operationId": "calcularPorcentajePanadero",
        "summary": "Calcula el porcentaje del panadero (baker's percentage)",
        "description": "Expresa cada ingrediente como % del peso de harina (la harina siempre es 100%). Detecta el agua para calcular la hidratación automáticamente.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["harina_g", "ingredientes"],
                "properties": {
                  "harina_g": { "type": "number", "description": "Peso de la harina en gramos." },
                  "ingredientes": {
                    "type": "array",
                    "description": "Demás ingredientes de la receta.",
                    "items": {
                      "type": "object",
                      "required": ["nombre", "gramos"],
                      "properties": {
                        "nombre": { "type": "string" },
                        "gramos": { "type": "number" }
                      }
                    }
                  },
                  "peso_porcion_g": { "type": "number", "description": "Peso por pieza en gramos. Opcional: calcula el número de porciones." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Tabla de porcentajes del panadero e hidratación" }
        }
      }
    },
    "/api/chatgpt/hidratacion-pan": {
      "post": {
        "operationId": "calcularHidratacionPan",
        "summary": "Calcula la hidratación de la masa de pan (bidireccional)",
        "description": "Modo calcular_porcentaje: harina_g + agua_g → devuelve % hidratación y clasificación. Modo calcular_agua: harina_g + hidratacion_pct → devuelve gramos de agua necesarios.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["harina_g"],
                "properties": {
                  "modo": {
                    "type": "string",
                    "enum": ["calcular_porcentaje", "calcular_agua"],
                    "description": "Por defecto calcular_porcentaje."
                  },
                  "harina_g": { "type": "number" },
                  "agua_g": { "type": "number", "description": "Requerido si modo=calcular_porcentaje." },
                  "hidratacion_pct": { "type": "number", "description": "Requerido si modo=calcular_agua." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Hidratación, clasificación y ejemplos de panes típicos" }
        }
      }
    },
    "/api/chatgpt/masa-madre": {
      "post": {
        "operationId": "calcularSustitucionMasaMadre",
        "summary": "Cuánta masa madre usar para sustituir levadura comercial",
        "description": "Convierte levadura fresca, seca o instantánea a masa madre activa. Calcula cuánta harina y agua restar de la receta para compensar lo que aporta la masa madre.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["levadura_g"],
                "properties": {
                  "tipo_levadura": {
                    "type": "string",
                    "enum": ["fresca", "seca", "instantanea"],
                    "description": "Por defecto seca."
                  },
                  "levadura_g": { "type": "number" },
                  "hidratacion_mm_pct": { "type": "number", "description": "Hidratación de tu masa madre en %. Por defecto 100." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Gramos de masa madre y ajuste de harina/agua en la receta" }
        }
      }
    },
    "/api/chatgpt/temperatura-masa": {
      "post": {
        "operationId": "calcularTemperaturaMasa",
        "summary": "Temperatura del agua para alcanzar la DDT (Desired Dough Temperature)",
        "description": "Fórmula: T_agua = DDT×3 − T_ambiente − T_harina − T_fricción. Con preferment usa factor ×4.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["t_ambiente_c"],
                "properties": {
                  "ddt_objetivo_c": { "type": "number", "description": "Temperatura deseada de la masa en °C. Por defecto 24°C." },
                  "t_ambiente_c": { "type": "number" },
                  "t_harina_c": { "type": "number", "description": "Por defecto igual a t_ambiente_c." },
                  "tipo_amasadora": {
                    "type": "string",
                    "enum": ["manual", "kitchen_aid", "amasadora_espiral", "thermomix"],
                    "description": "Por defecto manual."
                  },
                  "t_preferment_c": { "type": "number", "description": "Temperatura del preferment. Opcional." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Temperatura recomendada del agua en °C y °F" }
        }
      }
    },
    "/api/chatgpt/puntos-azucar": {
      "post": {
        "operationId": "calcularPuntosAzucar",
        "summary": "Identifica la fase del azúcar según la temperatura",
        "description": "Dado el °C del almíbar, devuelve la fase (almíbar, bola blanda, bola dura, caramelo...) con usos típicos y la prueba del vaso de agua fría.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["temperatura_c"],
                "properties": {
                  "temperatura_c": { "type": "number", "description": "Temperatura del almíbar en °C. Rango útil: 100–200°C." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Fase del azúcar, usos típicos y fase anterior/siguiente" }
        }
      }
    },
    "/api/chatgpt/gelatina-cocina": {
      "post": {
        "operationId": "calcularSustitucionGelatina",
        "summary": "Convierte entre tipos de gelatina por bloom strength",
        "description": "Equivalencias entre hojas bronce/plata/oro/platino, gelatina en polvo 200/250 bloom y agar-agar.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tipo_origen", "cantidad"],
                "properties": {
                  "tipo_origen": {
                    "type": "string",
                    "enum": ["hoja_bronce", "hoja_plata", "hoja_oro", "hoja_platino", "polvo_200", "polvo_250", "agar_agar"],
                    "description": "hoja_oro es la estándar en supermercados."
                  },
                  "cantidad": { "type": "number" },
                  "unidad": {
                    "type": "string",
                    "enum": ["gramos", "hojas"],
                    "description": "Por defecto gramos."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Tabla de equivalencias en gramos y hojas para todos los tipos" }
        }
      }
    },
    "/api/chatgpt/ganache": {
      "post": {
        "operationId": "calcularGanache",
        "summary": "Proporciones de chocolate y nata para ganache",
        "description": "Calcula gramos de chocolate y nata según tipo de chocolate (% cacao) y textura deseada. El ratio se ajusta automáticamente.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tipo_chocolate": {
                    "type": "string",
                    "enum": ["negro_extra", "negro", "semi_fondant", "con_leche", "blanco"],
                    "description": "negro_extra >70% | negro 55-70% | semi_fondant 40-55% | con_leche 28-40% | blanco. Por defecto negro."
                  },
                  "textura": {
                    "type": "string",
                    "enum": ["glaseado", "trufa", "firme"],
                    "description": "Por defecto trufa."
                  },
                  "total_g": { "type": "number", "description": "Gramos totales de ganache. Por defecto 200g." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Gramos de chocolate, gramos de nata, ratio y temperatura de trabajo" }
        }
      }
    },
    "/api/chatgpt/escalar-receta": {
      "post": {
        "operationId": "escalarReceta",
        "summary": "Escala una receta a más o menos raciones",
        "description": "Ajusta cantidades con redondeo práctico. Aplica escala no lineal para levadura, impulsores y especias. La temperatura del horno no cambia.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["raciones_original", "raciones_nueva", "ingredientes"],
                "properties": {
                  "raciones_original": { "type": "number" },
                  "raciones_nueva": { "type": "number" },
                  "ingredientes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["nombre", "cantidad", "unidad"],
                      "properties": {
                        "nombre": { "type": "string" },
                        "cantidad": { "type": "number" },
                        "unidad": { "type": "string" },
                        "categoria": {
                          "type": "string",
                          "enum": ["normal", "levadura", "impulsores", "sal", "especias"],
                          "description": "Por defecto normal."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Ingredientes escalados con cantidades redondeadas y nota de horno" }
        }
      }
    }
  }
}
