{
  "openapi": "3.1.0",
  "info": {
    "title": "meskeIA — Fotografía y Videografía Técnica",
    "description": "Calculadoras técnicas de fotografía y videografía: profundidad de campo, astrofotografía NPF, exposición equivalente, regla de los 180°, slow motion, filtros ND, bitrate de vídeo y ángulo de campo FOV.",
    "version": "2.0.0"
  },
  "servers": [
    { "url": "https://meskeia.com" }
  ],
  "paths": {
    "/api/chatgpt/profundidad-campo": {
      "post": {
        "operationId": "calcularProfundidadCampo",
        "summary": "Calcula DoF, hiperfocal y zona de nitidez",
        "description": "Calcula la profundidad de campo (DoF), distancia hiperfocal, límite cercano (Dn) y lejano (Df) de nitidez a partir de focal, apertura, distancia al sujeto y tipo de sensor.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["focal_mm", "apertura", "distancia_m"],
                "properties": {
                  "focal_mm": { "type": "number", "description": "Focal real del objetivo en milímetros (ej: 50, 85, 135)." },
                  "apertura": { "type": "number", "description": "Número f de apertura (ej: 1.4, 2.8, 5.6, 11)." },
                  "distancia_m": { "type": "number", "description": "Distancia al sujeto en metros (ej: 1.5, 3, 10)." },
                  "sensor": { "type": "string", "enum": ["ff", "apsc15", "apsc16", "m43"], "description": "Tipo de sensor: ff=Full Frame, apsc15=APS-C Nikon/Sony, apsc16=APS-C Canon, m43=Micro 4/3. Por defecto ff." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado del cálculo de profundidad de campo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sensor_usado": { "type": "string" },
                    "hiperfocal_m": { "type": "number" },
                    "dn_m": { "type": "number" },
                    "df_m": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
                    "dof_m": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
                    "clasificacion": { "type": "string" },
                    "aviso": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chatgpt/astrofoto-exposicion": {
      "post": {
        "operationId": "calcularAstrofotoExposicion",
        "summary": "Tiempo máximo sin estelas (regla 500, NPF)",
        "description": "Calcula el tiempo máximo de exposición para que las estrellas salgan como puntos, usando la regla 500 y la fórmula NPF más precisa que considera apertura, pixel pitch y declinación celeste.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["focal_mm", "apertura"],
                "properties": {
                  "focal_mm": { "type": "number", "description": "Focal real del objetivo en mm (ej: 14, 24, 35)." },
                  "apertura": { "type": "number", "description": "Número f de apertura (ej: 1.8, 2.8, 4)." },
                  "sensor": { "type": "string", "enum": ["ff", "apsc15", "apsc16", "m43"], "description": "Tipo de sensor. Por defecto ff." },
                  "megapixeles": { "type": "number", "description": "Megapíxeles del sensor (ej: 24, 36, 45). Por defecto 24." },
                  "declinacion_grados": { "type": "number", "description": "Declinación celeste en grados (0=ecuador, 30=Vía Láctea, 85=cerca Polaris). Por defecto 0." },
                  "tiempo_elegido_s": { "type": "number", "description": "Tiempo que el usuario quiere evaluar en segundos. Por defecto 20." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tiempos máximos y veredicto",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tiempo_maximo_npf_s": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
                    "tiempo_maximo_500_s": { "type": "number" },
                    "veredicto": { "type": "string" },
                    "descripcion": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chatgpt/exposicion-equivalente": {
      "post": {
        "operationId": "calcularExposicionEquivalente",
        "summary": "Calcula exposición equivalente (triángulo ISO/apertura/obturador)",
        "description": "Dado un triángulo de exposición base (ISO, apertura, velocidad), calcula la exposición equivalente al cambiar uno de los parámetros manteniendo el mismo EV.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["iso_base", "apertura_base", "obturador_base_s", "parametro_fijo", "nuevo_valor"],
                "properties": {
                  "iso_base": { "type": "number", "description": "ISO de partida (ej: 100, 400, 1600)." },
                  "apertura_base": { "type": "number", "description": "Apertura f de partida (ej: 2.8, 5.6)." },
                  "obturador_base_s": { "type": "number", "description": "Velocidad de obturación en segundos (ej: 0.01 para 1/100, 2 para 2s)." },
                  "parametro_fijo": { "type": "string", "enum": ["iso", "apertura", "obturador"], "description": "Qué parámetro cambia: iso (ajusta apertura), apertura (ajusta obturador), obturador (ajusta ISO)." },
                  "nuevo_valor": { "type": "number", "description": "Nuevo valor del parámetro elegido." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exposición equivalente calculada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "iso": { "type": "number" },
                    "apertura": { "type": "number" },
                    "obturador_fraccion": { "type": "string" },
                    "ev": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chatgpt/regla-180-video": {
      "post": {
        "operationId": "calcularRegla180Video",
        "summary": "Obturador correcto para vídeo según la regla de los 180°",
        "description": "Calcula la velocidad de obturación recomendada para cualquier frame rate según la regla de los 180°. Devuelve también una tabla con los fps más comunes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fps"],
                "properties": {
                  "fps": { "type": "number", "description": "Frame rate de grabación (ej. 24, 25, 30, 50, 60, 120, 240)." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Obturador recomendado y tabla de referencia",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "obturador_recomendado": { "type": "string" },
                    "descripcion": { "type": "string" },
                    "tabla_fps_comunes": { "type": "array" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chatgpt/camara-lenta": {
      "post": {
        "operationId": "calcularCamaraLenta",
        "summary": "Factor de ralentización y obturador para slow motion",
        "description": "Calcula el factor de ralentización de un vídeo slow motion a partir de los fps de grabación y reproducción. Devuelve el multiplicador, el obturador correcto según la regla 180° y opcionalmente la duración del clip ralentizado.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fps_grabacion", "fps_reproduccion"],
                "properties": {
                  "fps_grabacion": { "type": "number", "description": "FPS a los que se graba (ej. 120, 240, 960)." },
                  "fps_reproduccion": { "type": "number", "description": "FPS a los que se reproducirá (ej. 24, 25, 30)." },
                  "duracion_grabacion_s": { "type": "number", "description": "Duración del clip grabado en segundos. Opcional." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Factor slow motion y detalles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "factor_lentitud": { "type": "string" },
                    "nivel": { "type": "string" },
                    "obturador_grabacion": { "type": "string" },
                    "duracion_resultado_s": { "type": "number", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chatgpt/filtro-nd-video": {
      "post": {
        "operationId": "calcularFiltroNDVideo",
        "summary": "Filtro ND necesario para cumplir la regla de los 180° en exteriores",
        "description": "Calcula qué filtro ND se necesita para pasar de la velocidad de obturación actual a la correcta según la regla de los 180°. Devuelve las paradas exactas y una tabla ND2–ND1000.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fps", "obturador_actual_s"],
                "properties": {
                  "fps": { "type": "number", "description": "Frame rate de grabación (ej. 25, 30, 60)." },
                  "obturador_actual_s": { "type": "number", "description": "Velocidad de obturación actual en segundos (ej. 0.002 para 1/500, 0.004 para 1/250)." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Filtro ND recomendado y tabla de opciones",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "necesita_nd": { "type": "boolean" },
                    "paradas_necesarias": { "type": "number" },
                    "recomendacion": { "type": "string" },
                    "opciones": { "type": "array" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chatgpt/bitrate-video": {
      "post": {
        "operationId": "calcularBitrateVideo",
        "summary": "Estima el bitrate y tamaño de archivo de un vídeo",
        "description": "Calcula el bitrate y el tamaño aproximado según resolución, fps, duración y códec. Devuelve comparativa entre H.264, H.265, ProRes 422 y RAW.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["resolucion", "fps", "duracion_min"],
                "properties": {
                  "resolucion": { "type": "string", "enum": ["480p", "720p", "1080p", "2k", "4k", "8k"], "description": "Resolución del vídeo." },
                  "fps": { "type": "number", "description": "Frame rate (ej. 24, 30, 60)." },
                  "duracion_min": { "type": "number", "description": "Duración del vídeo en minutos." },
                  "codec": { "type": "string", "enum": ["h264", "h265", "prores422", "raw"], "description": "Códec. Por defecto h264." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bitrate y tamaño con comparativa de códecs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "bitrate_mbps": { "type": "number" },
                    "tamano": { "type": "string" },
                    "comparativa_codecs": { "type": "array" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chatgpt/fov-video": {
      "post": {
        "operationId": "calcularFOVVideo",
        "summary": "Calcula el ángulo de campo (FOV) para vídeo según focal y sensor",
        "description": "Calcula los ángulos de campo horizontal, vertical y diagonal. Incluye comparativa entre Full Frame, APS-C y Micro 4/3 con el focal equivalente en 35mm.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["focal_mm"],
                "properties": {
                  "focal_mm": { "type": "number", "description": "Focal del objetivo en milímetros (ej. 24, 35, 50, 85)." },
                  "sensor": { "type": "string", "enum": ["ff", "apsc15", "apsc16", "m43"], "description": "Tipo de sensor. Por defecto ff." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "FOV y comparativa de sensores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "fov_horizontal_deg": { "type": "number" },
                    "fov_vertical_deg": { "type": "number" },
                    "clasificacion": { "type": "string" },
                    "comparativa_sensores": { "type": "array" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
