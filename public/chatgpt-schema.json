{
  "openapi": "3.1.0",
  "info": {
    "title": "meskeIA — Calculadoras para España",
    "description": "Herramientas de cálculo especializadas para el sistema fiscal, laboral y de Seguridad Social español. Datos oficiales actualizados para 2026.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://meskeia.com"
    }
  ],
  "paths": {
    "/api/chatgpt/cuota-autonomo": {
      "post": {
        "operationId": "calcularCuotaAutonomo",
        "summary": "Calcular cuota mensual de autónomo en España (RETA 2026)",
        "description": "Calcula la cuota mensual de la Seguridad Social para autónomos en España. Usa los 15 tramos RETA 2026 oficiales. Aplica tarifa plana de 80€/mes para nuevos autónomos. Devuelve cuota mensual, anual y base de cotización efectiva.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InputCuotaAutonomo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado del cálculo con cuota mensual, anual y detalle del tramo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoCuotaAutonomo"
                }
              }
            }
          }
        }
      }
    },
    "/api/chatgpt/sueldo-neto": {
      "post": {
        "operationId": "calcularSueldoNeto",
        "summary": "Calcular sueldo neto mensual a partir del bruto anual (España 2025)",
        "description": "Calcula el sueldo neto mensual y anual de un trabajador en España. Aplica IRPF 2025 y cotizaciones SS cuenta ajena. Tiene en cuenta situación familiar e hijos.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InputSueldoNeto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado con neto mensual, anual, retención IRPF y cuota SS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoSueldoNeto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InputCuotaAutonomo": {
        "type": "object",
        "required": ["rendimientoNetoMensual"],
        "properties": {
          "rendimientoNetoMensual": {
            "type": "number",
            "minimum": 0,
            "description": "Rendimiento neto mensual en euros (ingresos - gastos deducibles, SIN descontar la cuota SS). Ejemplo: si facturas 2.500€ y tienes 500€ de gastos, el valor es 2000.",
            "example": 1800
          },
          "esNuevoAutonomo": {
            "type": "boolean",
            "default": false,
            "description": "true si es nuevo autónomo (primera alta o tras más de 2 años de baja). Aplica tarifa plana de 80€/mes durante 12 meses."
          },
          "baseElegida": {
            "type": "string",
            "enum": ["minima", "maxima"],
            "default": "minima",
            "description": "'minima' = cuota más baja. 'maxima' = mayor protección social pero cuota más alta."
          }
        }
      },
      "ResultadoCuotaAutonomo": {
        "type": "object",
        "properties": {
          "tramo": { "type": "integer", "description": "Tramo RETA 2026 (1-15)" },
          "baseCotizacion": { "type": "number", "description": "Base de cotización efectiva (€)" },
          "cuotaEfectiva": { "type": "number", "description": "Cuota mensual a pagar (€)" },
          "cuotaAnual": { "type": "number", "description": "Cuota anual estimada (€)" },
          "aplicaTarifaPlana": { "type": "boolean", "description": "true si aplica tarifa plana de 80€/mes" },
          "tipoCotizacion": { "type": "number", "description": "Tipo de cotización total (%)" },
          "fuenteDatos": { "type": "string" },
          "aviso_legal": { "type": "string" }
        }
      },
      "InputSueldoNeto": {
        "type": "object",
        "required": ["brutoAnual"],
        "properties": {
          "brutoAnual": {
            "type": "number",
            "minimum": 1,
            "description": "Salario bruto anual en euros. Ejemplo: 30000 para 30.000€/año.",
            "example": 30000
          },
          "situacion": {
            "type": "string",
            "enum": ["soltero", "casado_sin_ingresos", "casado_con_ingresos"],
            "default": "soltero",
            "description": "'soltero' (también divorciado/a, viudo/a), 'casado_sin_ingresos' (cónyuge sin ingresos), 'casado_con_ingresos' (ambos trabajan)."
          },
          "numHijos": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Número total de hijos a cargo."
          },
          "hijosMenores3": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Número de hijos menores de 3 años (tienen deducción adicional)."
          },
          "pagas": {
            "type": "integer",
            "enum": [12, 14],
            "default": 14,
            "description": "Número de pagas al año. 14 es lo más habitual en España."
          }
        }
      },
      "ResultadoSueldoNeto": {
        "type": "object",
        "properties": {
          "brutoAnual": { "type": "number", "description": "Bruto anual introducido (€)" },
          "cuotaSSAnual": { "type": "number", "description": "Cotización SS anual empleado (€)" },
          "cuotaIRPF": { "type": "number", "description": "Retención IRPF anual (€)" },
          "tipoRetencion": { "type": "number", "description": "Tipo de retención efectivo (%)" },
          "netoAnual": { "type": "number", "description": "Sueldo neto anual (€)" },
          "netoMensual": { "type": "number", "description": "Sueldo neto por paga (€)" },
          "pagas": { "type": "number", "description": "Número de pagas aplicado" },
          "fuenteDatos": { "type": "string" },
          "aviso_legal": { "type": "string" }
        }
      }
    }
  }
}
